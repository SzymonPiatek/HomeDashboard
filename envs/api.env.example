# apps/api — patrz envs/README.md dla kolejności ładowania.

# Musi być zgodne z envs/db.env — patrz envs/README.md.
DATABASE_URL=postgresql://homedashboard:changeme-dev-only@localhost:5433/homedashboard

PORT=4000

# Z Google Cloud Console, projekt OAuth właściciela.
GOOGLE_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret

# Musi być zarejestrowany jako "Authorized redirect URI" w Google Cloud Console.
# Port apps/web (3000), nie apps/api — patrz envs/README.md.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Jedyny adres, dla którego logowanie się powiedzie — .claude/rules/api.md.
OWNER_EMAIL=owner@example.com

# Czas życia sesji w dniach — ADR-0003. Brak sekretu podpisu: losowość id wystarcza.
SESSION_TTL_KIOSK_DAYS=180
SESSION_TTL_STANDARD_DAYS=7

# false w dev (http://localhost), true na produkcji — ADR-0003.
COOKIE_SECURE=false
