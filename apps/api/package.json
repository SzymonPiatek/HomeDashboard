{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --include \"../../packages/contracts/dist/**\" --env-file-if-exists=../../envs/shared.env --env-file-if-exists=../../envs/api.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=../../envs/shared.env --env-file-if-exists=../../envs/api.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "node --env-file-if-exists=../../envs/shared.env --env-file-if-exists=../../envs/api.env node_modules/vitest/vitest.mjs run",
    "db:migrate": "node --env-file-if-exists=../../envs/shared.env --env-file-if-exists=../../envs/api.env node_modules/prisma/build/index.js migrate dev",
    "db:generate": "node --env-file-if-exists=../../envs/shared.env --env-file-if-exists=../../envs/api.env node_modules/prisma/build/index.js generate",
    "db:seed": "node --env-file-if-exists=../../envs/shared.env --env-file-if-exists=../../envs/api.env node_modules/prisma/build/index.js db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "^7.10.0",
    "@repo/contracts": "workspace:*",
    "express": "^5.2.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@repo/config": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^24.10.1",
    "@types/supertest": "^6.0.3",
    "eslint": "^10.10.0",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.0"
  }
}
